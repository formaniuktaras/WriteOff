APP_NAME=WriteOff
ENV=development
DEBUG=true
SECRET_KEY=change-me-local-secret
SESSION_COOKIE_NAME=writeoff_session
SESSION_MAX_AGE=28800
SESSION_SECURE=false
SESSION_SAMESITE=lax
DATABASE_URL=postgresql+psycopg://writeoff:writeoff@localhost:5432/writeoff
STORAGE_ROOT=./data/storage
BACKUPS_ROOT=./data/backups
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.docx,.docm,.xlsx,.xlsm,.pdf,.zip,.txt,.jpg,.jpeg,.png
