# Copy one of the profiles below to .env and adjust credentials/secrets.
# - Local profile: for running FastAPI directly on host OS.
# - Docker profile: for docker compose where DB host is `db` service.

# ---------- Shared ----------
APP_NAME=WriteOff
ENV=production
DEBUG=false
SECRET_KEY=change-me-super-secret
SESSION_COOKIE_NAME=writeoff_session
SESSION_MAX_AGE=28800
SESSION_SECURE=false
SESSION_SAMESITE=lax
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=.docx,.docm,.xlsx,.xlsm,.pdf,.zip,.txt,.jpg,.jpeg,.png

# ---------- Local host profile (Linux/macOS/Windows) ----------
# Use localhost because PostgreSQL runs on your machine, not in Docker network.
# DATABASE_URL=postgresql+psycopg://writeoff:writeoff@localhost:5432/writeoff
# STORAGE_ROOT=./data/storage
# BACKUPS_ROOT=./data/backups

# ---------- Docker Compose profile ----------
# Use `db` because it is the Docker service name in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://writeoff:writeoff@db:5432/writeoff
STORAGE_ROOT=/data/storage
BACKUPS_ROOT=/data/backups
